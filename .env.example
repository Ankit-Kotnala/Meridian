# Copy to .env for local development. These values are development-only.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / pgvector
POSTGRES_USER=rezumi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rezumi
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://rezumi:change-me-local-only@postgres:5432/rezumi
# Default pool (5 + 10 overflow = 15) is undersized for local dev: a single page
# load fans out 15-20+ concurrent API calls, exhausting the pool and causing
# connection-checkout waits that trip the web BFF's proxy timeout.
REZUMI_DATABASE_POOL_SIZE=20
REZUMI_DATABASE_MAX_OVERFLOW=20

# Redis / Celery / authentication abuse controls
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# MongoDB parsed resume storage
# Production/staging: use a MongoDB Atlas SRV URI (never commit real credentials).
MONGODB_ENABLED=false
MONGODB_URL=mongodb://mongo:27017
MONGODB_DATABASE=Rezumi
MONGODB_USER_DATA_COLLECTION=user-data
# Owner-scoped copy of Application Profile answers used by Apply for me.
MONGODB_APPLICATION_PROFILE_COLLECTION=application-profiles
# Comma-separated allowlist of employer Greenhouse boards that expose the
# documented public Job Board API. Only India-located listings are ingested.
GREENHOUSE_INDIA_BOARD_TOKENS=cialfo,highradius,knowbe4,skillzinc,mixpanel
# Comma-separated allowlist of verified public employer boards. All locations
# are ingested for these boards, users should review location and work-authorization requirements.
GREENHOUSE_GLOBAL_BOARD_TOKENS=abnormalsecurity,airbnb,airtable,braze,brex,checkr,chime,cockroachlabs,collibra,coinbase,cloudflare,contentful,coursera,databricks,dropbox,duolingo,elastic,everlaw,figma,flexport,glossier,gusto,hellofresh,instacart,intercom,liveperson,lyft,marqeta,netlify,newrelic,nuro,okta,onetrust,opentable,pantheon,pinterest,postman,prolific,qualtrics,reddit,relativity,revolut,robinhood,rubrik,scaleai,stripe,appdirect,blend,celonis,coreweave,cultureamp,dremio,epicgames,fanduel,fivetran,klaviyo,launchdarkly,lattice,mongodb,pagerduty,pandadoc,pendo,ripple,samsara,seatgeek,securityscorecard,squarespace,sumup,toast,truelayer,twilio,udemy,unqork,upwork,vercel,via,workato,zscaler,6sense,affirm,algolia,alphasense,amplitude,andurilindustries,anthropic,applovin,asana,betterment,billcom,bitgo,bloomreach,boxinc,calendly,carta,circleci,commercetools,cribl,datadog,faire,fastly,freenome,gitlab,gongio,hightouch,honeycomb,humaninterest,khanacademy,nextdoor,roku,sproutsocial,stackadapt,sumologic,taboola,typeform,udacity,webflow,weave,wizinc,axonius,branch,buildkite,dataiku
# Comma-separated allowlist of employer Ashby boards that expose the documented
# public job-board API. Only India-located listings are ingested.
ASHBY_INDIA_BOARD_NAMES=riveron,office-hours,emergence

# S3-compatible storage (MinIO locally)
MINIO_ROOT_USER=rezumi-local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rezumi-documents
# The application identity is intentionally different from the MinIO root user.
# Compose creates it with access limited to the document bucket.
S3_APP_ACCESS_KEY_ID=rezumi-app
S3_APP_SECRET_ACCESS_KEY=change-me-local-only-app-storage-secret
S3_ALLOWED_ORIGIN=http://localhost:3000
S3_USE_SSL=false

# Phase 2 document admission. ClamAV is required for local processing; a scanner
# outage leaves uploaded bytes quarantined and fails closed.
MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_PORT_INTERNAL=3310
CLAMAV_TIMEOUT_SECONDS=30
DOCUMENT_TEMP_ROOT=/tmp/rezumi
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=8
DOCUMENT_MAX_ARCHIVE_ENTRIES=256
DOCUMENT_MAX_UNCOMPRESSED_BYTES=52428800
DOCUMENT_MAX_COMPRESSION_RATIO=100
DOCUMENT_MAX_EXTRACTED_CHARACTERS=500000
DOCUMENT_MAX_EXTRACTED_BLOCKS=5000
DOCUMENT_MAX_SERIALIZED_ARTIFACT_BYTES=2097152
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=120
WORKER_CONCURRENCY=2
WORKER_MEMORY_LIMIT=768m
WORKER_CPU_LIMIT=1.0
WORKER_SCHEDULER_MEMORY_LIMIT=256m
WORKER_SCHEDULER_CPU_LIMIT=0.25
RESUME_JOB_RECONCILIATION_INTERVAL_SECONDS=60
RESUME_JOB_RECONCILIATION_STALE_SECONDS=300
ATTACHMENT_JOB_RECONCILIATION_INTERVAL_SECONDS=60
ATTACHMENT_JOB_RECONCILIATION_STALE_SECONDS=300
RESUME_EXPORT_LEASE_SECONDS=330
RESUME_EXPORT_MAX_BYTES=8388608
RESUME_EXPORT_RETRY_SECONDS=30
RESUME_EXPORT_OUTBOX_INTERVAL_SECONDS=5
RESUME_EXPORT_OUTBOX_LEASE_SECONDS=30
RESUME_EXPORT_OUTBOX_MAX_ATTEMPTS=5
RESUME_EXPORT_RECONCILIATION_INTERVAL_SECONDS=60
RESUME_EXPORT_RECONCILIATION_STALE_SECONDS=300
RESUME_EXPORT_ORPHAN_CLEANUP_GRACE_SECONDS=300
ANALYTICS_MAX_ATTEMPTS=3
ANALYTICS_JOB_LEASE_SECONDS=360
ANALYTICS_RETRY_SECONDS=30
ANALYTICS_OUTBOX_INTERVAL_SECONDS=5
ANALYTICS_RECONCILIATION_INTERVAL_SECONDS=60
NETWORKING_REMINDER_LEASE_SECONDS=120
NETWORKING_REMINDER_RETRY_SECONDS=30
NETWORKING_REMINDER_INTERVAL_SECONDS=30
NETWORKING_RECONCILIATION_INTERVAL_SECONDS=60
CLAMAV_MEMORY_LIMIT=2g
CLAMAV_CPU_LIMIT=1.5

# Applications
API_PORT=8000
WEB_PORT=3000
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESUME_CAPABILITY_PEPPER=change-me-local-only-resume-capability-pepper
BFF_CLIENT_SIGNAL_SECRET=change-me-local-only-bff-client-signal-secret
API_BFF_CLIENT_SIGNAL_SECRET=change-me-local-only-bff-client-signal-secret
API_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Authentication. These values are safe for local development only. Production
# validation rejects this token pepper and insecure cookies.
AUTH_TOKEN_PEPPER=change-me-local-only-auth-token-pepper
COOKIE_SECURE=false
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
RECENT_AUTH_TTL_SECONDS=600
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
CONSENT_POLICY_VERSION=2026-07-15

# Local email capture. Mailpit is a required development dependency so
# registration, verification, and recovery flows exercise real SMTP delivery.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@rezumi.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Google OAuth is fail-closed unless explicitly enabled with a complete provider
# configuration. Local and CI auth tests use deterministic non-Google paths.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Optional: GitHub GraphQL requires an application-owned token. Supplying a
# fine-grained token with access only to public resources adds pinned projects,
# current-year public contribution totals, and licensed organization activity
# to declared GitHub profile imports. Public REST profile/README imports work
# without it. Never commit a real token.
GITHUB_API_TOKEN=

# Settings capability providers remain fail-closed until Phase 10 policy and
# provider decisions are approved.
ACCOUNT_EXPORT_PROVIDER=disabled
ACCOUNT_DELETION_PROVIDER=disabled
BILLING_PROVIDER=disabled

# Provider selection. Deterministic/local providers remain the safe development
# default. Production rejects deterministic AI configuration and requires an
# explicitly reviewed provider adapter.
AI_PROVIDER=deterministic
AI_HTTP_ENDPOINT_URL=
AI_HTTP_API_KEY=
AI_HTTP_TIMEOUT_SECONDS=10
AI_HTTP_MAX_ATTEMPTS=2
AI_HTTP_MAX_RESPONSE_BYTES=262144
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60
OCR_PROVIDER=disabled
