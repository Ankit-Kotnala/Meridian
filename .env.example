# Copy to .env for local development. These values are development-only.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / pgvector
POSTGRES_USER=careeros
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=careeros
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://careeros:change-me-local-only@postgres:5432/careeros

# Redis / Celery / authentication abuse controls
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible storage (MinIO locally)
MINIO_ROOT_USER=careeros-local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=careeros-documents
# The application identity is intentionally different from the MinIO root user.
# Compose creates it with access limited to the document bucket.
S3_APP_ACCESS_KEY_ID=careeros-app
S3_APP_SECRET_ACCESS_KEY=change-me-local-only-app-storage-secret
S3_ALLOWED_ORIGIN=http://localhost:3000
S3_USE_SSL=false

# Phase 2 document admission. ClamAV is required for local processing; a scanner
# outage leaves uploaded bytes quarantined and fails closed.
MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_PORT_INTERNAL=3310
CLAMAV_TIMEOUT_SECONDS=30
DOCUMENT_TEMP_ROOT=/tmp/careeros
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=8
DOCUMENT_MAX_ARCHIVE_ENTRIES=256
DOCUMENT_MAX_UNCOMPRESSED_BYTES=52428800
DOCUMENT_MAX_COMPRESSION_RATIO=100
DOCUMENT_MAX_EXTRACTED_CHARACTERS=500000
DOCUMENT_MAX_EXTRACTED_BLOCKS=5000
DOCUMENT_MAX_SERIALIZED_ARTIFACT_BYTES=2097152
DOCUMENT_PROCESSING_TIMEOUT_SECONDS=120
WORKER_CONCURRENCY=2
WORKER_MEMORY_LIMIT=768m
WORKER_CPU_LIMIT=1.0
WORKER_SCHEDULER_MEMORY_LIMIT=256m
WORKER_SCHEDULER_CPU_LIMIT=0.25
RESUME_JOB_RECONCILIATION_INTERVAL_SECONDS=60
RESUME_JOB_RECONCILIATION_STALE_SECONDS=300
CLAMAV_MEMORY_LIMIT=2g
CLAMAV_CPU_LIMIT=1.5

# Applications
API_PORT=8000
WEB_PORT=3000
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000"]
CORS_ORIGINS=["http://localhost:3000"]
PUBLIC_APP_URL=http://localhost:3000
RESUME_CAPABILITY_PEPPER=change-me-local-only-resume-capability-pepper
BFF_CLIENT_SIGNAL_SECRET=change-me-local-only-bff-client-signal-secret
API_BFF_CLIENT_SIGNAL_SECRET=change-me-local-only-bff-client-signal-secret
API_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Authentication. These values are safe for local development only. Production
# validation rejects this token pepper and insecure cookies.
AUTH_TOKEN_PEPPER=change-me-local-only-auth-token-pepper
COOKIE_SECURE=false
SESSION_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
RECENT_AUTH_TTL_SECONDS=600
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
CONSENT_POLICY_VERSION=2026-07-15

# Local email capture. Mailpit is a required development dependency so
# registration, verification, and recovery flows exercise real SMTP delivery.
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@careeros.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=false
MAILPIT_SMTP_PORT=1025
MAILPIT_HTTP_PORT=8025

# Google OAuth is fail-closed unless explicitly enabled with a complete provider
# configuration. Local and CI auth tests use deterministic non-Google paths.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# Provider selection. Deterministic/local providers remain the safe default.
AI_PROVIDER=fake
OCR_PROVIDER=disabled
