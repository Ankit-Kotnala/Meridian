# Copy to .env for local development. These values are development-only.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL / pgvector
POSTGRES_USER=careeros
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=careeros
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://careeros:change-me-local-only@postgres:5432/careeros

# Redis / Celery
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# S3-compatible storage (MinIO locally)
MINIO_ROOT_USER=careeros-local
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=careeros-documents
S3_ACCESS_KEY_ID=careeros-local
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_USE_SSL=false

# Applications
API_PORT=8000
WEB_PORT=3000
API_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Provider selection. Phase 0 ships deterministic/local providers only.
AI_PROVIDER=fake
MALWARE_SCANNER_PROVIDER=disabled
OCR_PROVIDER=disabled
