{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RezumiBucketMetadata",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": ["arn:aws:s3:::rezumi-documents"]
    },
    {
      "Sid": "RezumiDocumentObjects",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": ["arn:aws:s3:::rezumi-documents/*"]
    }
  ]
}
