{
  "name": "careeros",
  "version": "0.1.0",
  "private": true,
  "description": "Truth-locked career application operating system",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@careeros/web",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint && pnpm check:boundaries",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm test:edge",
    "test:edge": "node --test infra/docker/web-edge/*.test.mjs",
    "test:e2e": "pnpm --filter @careeros/web test:e2e",
    "seed": "pnpm --filter @careeros/test-fixtures seed",
    "contracts:export": "uv run --package careeros-api python packages/contracts/scripts/export_openapi.py",
    "contracts:generate": "pnpm contracts:export && pnpm --filter @careeros/contracts generate",
    "contracts:check": "uv run --package careeros-api python packages/contracts/scripts/export_openapi.py --check && pnpm --filter @careeros/contracts check-generated",
    "check:boundaries": "node scripts/check-repository.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "turbo": "2.10.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
