{
  "name": "rezumi",
  "version": "0.1.0",
  "private": true,
  "description": "Truth-locked career application operating system",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "frontend/web",
    "shared/contracts",
    "frontend/design-tokens",
    "frontend/eslint-config",
    "frontend/test-fixtures",
    "frontend/typescript-config",
    "frontend/ui"
  ],
  "overrides": {
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.19",
    "sharp": "0.35.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "turbo run dev --filter=@rezumi/web",
    "dev:web": "node scripts/local.mjs dev-web",
    "dev:api": "node scripts/local.mjs dev-api",
    "dev:worker": "node scripts/local.mjs dev-worker",
    "local:up": "node scripts/local.mjs up full",
    "local:backend": "node scripts/local.mjs up backend",
    "local:deps": "node scripts/local.mjs up dependencies",
    "local:rebuild": "node scripts/local.mjs rebuild all",
    "local:rebuild:web": "node scripts/local.mjs rebuild web",
    "local:rebuild:backend": "node scripts/local.mjs rebuild backend",
    "local:down": "node scripts/local.mjs down",
    "local:status": "node scripts/local.mjs status",
    "local:logs": "node scripts/local.mjs logs",
    "local:smoke": "node scripts/local.mjs smoke full",
    "local:smoke:backend": "node scripts/local.mjs smoke backend",
    "build": "turbo run build",
    "format": "node scripts/run-prettier.mjs --write",
    "format:check": "node scripts/run-prettier.mjs --check",
    "lint": "turbo run lint && npm run check:boundaries",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && npm run test:edge",
    "test:web": "npm run test --workspace=@rezumi/web",
    "test:api": "uv run --project backend --package rezumi-api pytest backend/api/tests",
    "test:worker": "uv run --project backend --package rezumi-worker pytest backend/worker/tests",
    "test:backend": "uv run --project backend --package rezumi-backend pytest backend/core/tests/architecture backend/core/tests/unit",
    "test:edge": "node --test infra/docker/web-edge/*.test.mjs",
    "test:e2e": "npm run test:e2e --workspace=@rezumi/web",
    "fixtures:preview": "npm run preview --workspace=@rezumi/test-fixtures",
    "contracts:export": "uv run --project backend --package rezumi-api python shared/contracts/scripts/export_openapi.py",
    "contracts:generate": "npm run contracts:export && npm run generate --workspace=@rezumi/contracts",
    "contracts:check": "uv run --project backend --package rezumi-api python shared/contracts/scripts/export_openapi.py --check && npm run check-generated --workspace=@rezumi/contracts",
    "check:boundaries": "node scripts/check-repository.mjs"
  },
  "devDependencies": {
    "patch-package": "8.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
