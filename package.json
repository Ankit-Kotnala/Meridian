{
  "name": "careeros",
  "version": "0.1.0",
  "private": true,
  "description": "Truth-locked career application operating system",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @careeros/web dev",
    "build": "pnpm -r --if-present run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "pnpm --filter @careeros/web test:e2e",
    "seed": "pnpm --filter @careeros/test-fixtures seed"
  },
  "devDependencies": {
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
